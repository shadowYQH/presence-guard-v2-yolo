<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <com.presenceguard.yolo.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部状态卡 -->
    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_idle" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/status_booting"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/statusDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/status_booting_detail"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!--
        底部停靠区：指标行 + 控制栏。
        两者放进同一个纵向 LinearLayout，指标自然排在按钮上方，无论如何都不会压到按钮
        —— 之前用绝对 marginBottom 避让，按钮加到第三行就压住了帧率文字。
    -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp">

        <!-- 指标行：帧率 / 耗时 / 分值 / 巡检结果 -->
        <TextView
            android:id="@+id/metricsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_panel_soft"
            android:fontFamily="monospace"
            android:maxLines="4"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 底部控制栏 -->
        <LinearLayout
            android:id="@+id/controlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSwitch"
                    style="@style/ControlButton"
                    android:text="@string/btn_switch" />

                <TextView
                    android:id="@+id/btnSensitivity"
                    style="@style/ControlButton"
                    android:text="@string/btn_sensitivity_medium" />

                <TextView
                    android:id="@+id/btnTone"
                    style="@style/ControlButton"
                    android:text="@string/btn_tone_default" />

                <TextView
                    android:id="@+id/btnSound"
                    style="@style/ControlButton"
                    android:text="@string/btn_sound_on" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPause"
                    style="@style/ControlButton"
                    android:text="@string/btn_pause" />

                <TextView
                    android:id="@+id/btnTest"
                    style="@style/ControlButton"
                    android:text="@string/btn_test" />

                <TextView
                    android:id="@+id/btnDim"
                    style="@style/ControlButton"
                    android:text="@string/btn_dim" />

                <TextView
                    android:id="@+id/btnPower"
                    style="@style/ControlButton"
                    android:text="@string/btn_power_off" />
            </LinearLayout>

            <!-- 第三行：焦段 / 镜头 / 选区 / 清空 / 巡检 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnZoom"
                    style="@style/ControlButton"
                    android:text="@string/btn_zoom_default" />

                <TextView
                    android:id="@+id/btnLens"
                    style="@style/ControlButton"
                    android:text="@string/btn_lens_default"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnRoi"
                    style="@style/ControlButton"
                    android:text="@string/btn_roi" />

                <TextView
                    android:id="@+id/btnRoiUndo"
                    style="@style/ControlButton"
                    android:text="@string/btn_roi_clear" />

                <TextView
                    android:id="@+id/btnInspect"
                    style="@style/ControlButton"
                    android:text="@string/btn_inspect_dual" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 权限引导 -->
    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_base"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/permission_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/permission_body"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnGrant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:paddingHorizontal="32dp"
            android:paddingVertical="14dp"
            android:text="@string/permission_action"
            android:textColor="#FF06120A"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
